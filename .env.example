# ============================================
# Program1 Environment Configuration Template
# ============================================
# Copy this file to `.env` and adjust the values.
# NEVER commit the `.env` file containing production secrets to git!

# --- Application ---
APP_ENV=development                            # development | staging | production
APP_PORT=8080                                  # Internal port (Docker maps 6090:8080)
RUST_LOG=info,program1=debug,tower_http=debug

# --- Store Metadata ---
STORE_NAME="AURA Storefront"
STORE_CURRENCY="IDR"

# --- Database (SQLite Persistence) ---
DATABASE_URL=sqlite://./data/program1.db?mode=rwc
# For PostgreSQL / external DB:
# DATABASE_URL=postgres://program1_user:secretpassword@localhost:5432/program1

# --- Authentication & RBAC ---
# IMPORTANT: In production, generate a secure random 32+ character key and strong password!
ADMIN_DEFAULT_PASSWORD=admin123
JWT_SECRET=super-secret-program1-jwt-signing-key-32chars-min!
JWT_EXPIRY_HOURS=24

# --- Security & CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:6090,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:6090,http://127.0.0.1:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_SECOND=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

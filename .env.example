# ============================================
# Program1 Environment Configuration Template
# ============================================
# Copy this file to `.env` and adjust the values.
# NEVER commit the `.env` file containing production secrets to git!

# --- Application ---
APP_ENV=development                            # development | staging | production
APP_PORT=8080                                  # Internal port (Docker maps 6090:8080)
RUST_LOG=info,program1=debug,tower_http=debug

# --- Store Metadata ---
STORE_NAME="AURA Storefront"
STORE_CURRENCY="IDR"
STORE_WHATSAPP_NUMBER="6281234567890"

# --- Database (SQLite Persistence) ---
DATABASE_URL=sqlite://./data/program1.db?mode=rwc
# For PostgreSQL / external DB:
# DATABASE_URL=postgres://program1_user:secretpassword@localhost:5432/program1

# --- Authentication & RBAC ---
# IMPORTANT: In production, generate a secure random 32+ character key and strong password!
ADMIN_DEFAULT_PASSWORD=admin123
DEV_SUPPORT_PASSWORD=dev_support_secret_token_16chars_min
JWT_SECRET=super-secret-program1-jwt-signing-key-32chars-min!
JWT_EXPIRY_HOURS=24

# --- Security & CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:6090,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:6090,http://127.0.0.1:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_SECOND=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Buyer Google OAuth / OIDC ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Buyer Phone OTP Verification (SMS / WhatsApp) ---
# Supported providers: 
#   - console (dev simulation: automatically auto-fills & displays OTP in modal)
#   - fonnte (WhatsApp Gateway via https://api.fonnte.com/send - token in SMS_PROVIDER_API_KEY)
#   - generic_http (Custom webhook URL e.g. https://your-wa-gateway.com/send)
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=your-sms-or-fonnte-api-key
SMS_PROVIDER_SENDER_ID=PROGRAM1
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Payment Gateway (Midtrans) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxx
MIDTRANS_IS_PRODUCTION=false

# --- Email Notification (SMTP / Console) ---
EMAIL_PROVIDER=console             # console | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@aura.co.id
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="AURA Storefront"
SMTP_FROM_EMAIL=noreply@aura.co.id

# --- Shipping (RajaOngkir) ---
RAJAONGKIR_API_KEY=
RAJAONGKIR_TYPE=starter                            # starter | basic | pro
SHIPPING_ORIGIN_CITY_ID=152                        # Default: 152 (Jakarta Selatan)

